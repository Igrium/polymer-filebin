{
	"schemaVersion": 1,
	"id": "polymer-filebin",
	"version": "${version}",
	"name": "Polymer Filebin",
	"description": "Automatically hosts Polymer resource packs on Filebin, so no HTTP port needs to be exposed (works with e4mc and similar tunnels).",
	"authors": [
		"Igrium"
	],
	"contact": {
		"sources": "https://github.com/Igrium/polymer-filebin"
	},
	"license": "LGPL-3.0",
	"icon": "assets/polymer-filebin/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.igrium.polymerfilebin.PolymerFilebin"
		]
	},
	"mixins": [
		"polymer-filebin.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-resource-pack": "*"
	}
}
